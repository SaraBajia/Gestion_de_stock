<Window x:Class="WpfApp1.Window13"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Airbus – Gestion des commandes"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="NavyBrush" Color="#0B3D6B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D0DCE8"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#6B85A0"/>

        <Style x:Key="FilterBtn" TargetType="RadioButton">
            <Setter Property="GroupName" Value="FiltreStatut"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#6B85A0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="White" BorderBrush="#D0DCE8" BorderThickness="1" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0B3D6B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0B3D6B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0B3D6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSave" TargetType="Button">
            <Setter Property="Background" Value="#0B3D6B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#144d7e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>


        <Border DockPanel.Dock="Top" Background="White" Height="60" BorderBrush="#D0DCE8" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <Button Grid.Column="0" x:Name="BtnRetour" Command="{Binding RetourCommand}"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" Foreground="#0B3D6B"/>
                        <TextBlock Text="Airbus" FontSize="15" FontWeight="Bold" Foreground="#0B3D6B" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>


                <TextBlock Grid.Column="1" Text="Gestion des commandes" FontSize="17" FontWeight="Bold"
                           Foreground="#0B3D6B" HorizontalAlignment="Center" VerticalAlignment="Center"/>


                <Button Grid.Column="2" x:Name="BtnDeconnexion" Command="{Binding DeconnexionCommand}"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <!-- أيقونة تسجيل الخروج بلون أحمر خفيف أو داكن لتمييزها -->
                        <materialDesign:PackIcon Kind="Logout" Width="18" Height="18" Foreground="#D32F2F"/>
                        <TextBlock Text="Se déconnecter" FontSize="13" FontWeight="SemiBold" Foreground="#D32F2F" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>


        <Border DockPanel.Dock="Top" Background="#F4F7FB" Padding="24,16,24,10">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="FiltreTous" Content="Toutes" Style="{StaticResource FilterBtn}" IsChecked="True" Command="{Binding FiltreCommand}" CommandParameter=""/>
                <RadioButton x:Name="FiltreEnAttente" Content="En attente" Style="{StaticResource FilterBtn}" Command="{Binding FiltreCommand}" CommandParameter="En attente"/>
                <RadioButton x:Name="FiltreValidee" Content="Validée" Style="{StaticResource FilterBtn}" Command="{Binding FiltreCommand}" CommandParameter="Validée"/>
                <RadioButton x:Name="FiltreRefusee" Content="Refusée" Style="{StaticResource FilterBtn}" Command="{Binding FiltreCommand}" CommandParameter="Refusée"/>
            </StackPanel>
        </Border>


        <Border Margin="24,0,24,24" Background="White" CornerRadius="12" BorderBrush="#D0DCE8" BorderThickness="1">
            <DataGrid x:Name="GridCommandes" ItemsSource="{Binding Commandes}" AutoGenerateColumns="False" IsReadOnly="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="52"
                      Background="White" BorderThickness="0" CanUserAddRows="False" CanUserDeleteRows="False"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F4F7FB"/>
                        <Setter Property="Foreground" Value="#0B3D6B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="Padding" Value="10,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#D0DCE8"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding DateCommande}" Width="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Type PC" Binding="{Binding TypePc}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="140" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Demandeur" Binding="{Binding Demandeur}" Width="140" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Bénéficiaire" Binding="{Binding Beneficiaire}" Width="140" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Commentaire" Binding="{Binding Commentaire}" Width="*" IsReadOnly="True"/>


                    <DataGridTemplateColumn Header="Statut actuel" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="8,4" HorizontalAlignment="Left" Background="{Binding StatutCouleur}">
                                    <TextBlock Text="{Binding Statut}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>


                    <DataGridTemplateColumn Header="Changer statut" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding StatutOptions}" 
                                          SelectedItem="{Binding NouveauStatut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          Height="30" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>


                    <DataGridTemplateColumn Header="Action" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Enregistrer" Style="{StaticResource BtnSave}" Command="{Binding DataContext.EnregistrerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </DockPanel>
</Window>
<Window x:Class="WpfApp1.Window14"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des Utilisateurs" Height="750" Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Window.Resources>
        <!-- الستايل الخاص بأزرار القائمة الجانبية -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCDDEE"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderThickness="0" CornerRadius="6" Margin="8,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A4A7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="#1A4A7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- الستايل الخاص بالأزرار العادية -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ستايل حذف السطر (أيقونة السلة داخل الجدول) -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FDEDEC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ستايل الكروت الإحصائية (KPI Cards) -->
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="BorderBrush" Value="#E2E6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ستايل الـ DataGrid الافتراضي -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EAECEF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="RowHeight" Value="42"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0B3D6B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#0A3560"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0" Background="#0B3D6B">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Background="#092F52" Padding="20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnRetour"
                                    Content="&#xE76B;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13"
                                    Foreground="White"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="0"
                                    Width="18" Height="18"
                                    Margin="0,0,4,0"
                                    Command="{Binding RetourCommand}"
                                    ToolTip="Retour"/>
                            <TextBlock Text="AIRBUS" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Gestion de Stock IT" Foreground="#88AACC" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Background="#092F52" Padding="16,16">
                    <StackPanel>
                        <TextBlock x:Name="txtUserName" Text="{Binding TxtUserName}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtUserRole" Text="{Binding TxtUserRole}" Foreground="#88AACC" FontSize="10" Margin="0,2,0,0"/>
                        <Button Content="Se déconnecter" Margin="0,12,0,0" Style="{StaticResource ActionButtonStyle}" Background="#C0392B" Foreground="White" FontSize="11" Command="{Binding DeconnecterCommand}"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,15,0,0">
                    <Button Style="{StaticResource SidebarButtonStyle}" Margin="0,4" Command="{Binding RetourCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏠" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Accueil"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonActiveStyle}" Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Utilisateurs"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border x:Name="headerBorder" Grid.Row="0" Background="White" Padding="24,16" BorderBrush="#E2E6EA" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="txtHeaderTitle" Text="Gestion des Utilisateurs" FontSize="19" FontWeight="Bold" Foreground="#0B3D6B" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="txtHeaderDesc" Text="Consultez, recherchez et gérez les comptes du système" FontSize="11" Foreground="#888" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <!-- زر تبديل المظهر الدائري: مثبت بالكامل على أيقونة الشمس E706 من صورتك -->
                    <Button x:Name="btnThemeToggle" 
                            Grid.Column="1" 
                            Content="&#xE706;" 
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="18"
                            Width="40" 
                            Height="40" 
                            Cursor="Hand"
                            Click="BtnToggleTheme_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F0F2F5"/>
                                <Setter Property="Foreground" Value="#0B3D6B"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" 
                                                    Background="{TemplateBinding Background}" 
                                                    CornerRadius="20" 
                                                    BorderBrush="#E2E6EA"
                                                    BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#EAF1F8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- KPI Cards -->
            <Grid Grid.Row="1" Margin="24,16,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <UniformGrid Grid.Column="0" Rows="1" Columns="3">
                    <Border x:Name="kpiCard1" Style="{StaticResource KpiCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="txtKpiTitle1" Text="TOTAL UTILISATEURS" FontSize="10" Foreground="#999" FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtTotalUtilisateurs" Text="{Binding TotalUtilisateurs}" FontSize="28" FontWeight="Bold" Foreground="#0B3D6B" Margin="0,4,0,0"/>
                            <TextBlock Text="👥 Comptes enregistrés" FontSize="10" Foreground="#AAA" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="kpiCard2" Style="{StaticResource KpiCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="txtKpiTitle2" Text="DERNIER INSCRIT" FontSize="10" Foreground="#999" FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtDernierUtilisateur" Text="{Binding DernierUtilisateur}" FontSize="18" FontWeight="Bold" Foreground="#27AE60" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtDernierEmail" Text="{Binding DernierEmail}" FontSize="10" Foreground="#AAA" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="kpiCard3" Style="{StaticResource KpiCardStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock x:Name="txtKpiTitle3" Text="RECHERCHER" FontSize="10" Foreground="#999" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Border Background="#F5F7FA" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtSearch" Grid.Column="0" Padding="10,6" BorderThickness="0" Background="Transparent" FontSize="12" VerticalAlignment="Center" FontFamily="Segoe UI" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="1" Text="🔍" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" Foreground="#888"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Répartition des rôles -->
                <Border x:Name="kpiCard4" Grid.Column="1" Style="{StaticResource KpiCardStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock x:Name="txtKpiTitle4" Text="RÉPARTITION DES RÔLES" FontSize="10" Foreground="#999" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="icRoleStats" ItemsSource="{Binding RoleStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Role}" FontSize="12" FontWeight="SemiBold" Foreground="#333"/>
                                            <TextBlock Grid.Column="1" FontSize="11" Foreground="#888">
                                                <Run Text="{Binding Count, Mode=OneWay}"/>
                                                <Run Text=" ("/>
                                                <Run Text="{Binding Pourcentage, Mode=OneWay}"/>
                                                <Run Text=")"/>
                                            </TextBlock>
                                        </Grid>
                                        <Border Height="6" Background="#EAECEF" CornerRadius="3" Margin="0,5,0,0">
                                            <Border Height="6" CornerRadius="3" HorizontalAlignment="Left"
                                                    Width="{Binding LargeurBarre}" Background="{Binding BarreCouleur}"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Barre d'actions -->
            <Grid Grid.Row="2" Margin="24,16,24,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtListTitle" Grid.Column="0" Text="Liste des utilisateurs" FontSize="14" FontWeight="SemiBold" Foreground="#0B3D6B" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="🗑 Supprimer la sélection" Style="{StaticResource ActionButtonStyle}" Background="#E74C3C" Foreground="White" Command="{Binding SupprimerSelectionCommand}"/>
            </Grid>

            <!-- DataGrid Container -->
            <Border x:Name="gridContainer" Grid.Row="3" Margin="24,0,24,20" CornerRadius="8" BorderBrush="#E2E6EA" BorderThickness="1" Background="White">
                <DataGrid x:Name="dgUsers" ItemsSource="{Binding DataView}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          CanUserResizeRows="False"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="60"/>
                        <DataGridTextColumn Header="NOM" Binding="{Binding nom}" Width="1.3*"/>
                        <DataGridTextColumn Header="PRÉNOM" Binding="{Binding prenom}" Width="1.3*"/>
                        <DataGridTextColumn Header="EMAIL" Binding="{Binding email}" Width="2*"/>

                        <DataGridTemplateColumn Header="RÔLE" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#EAF1F8"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                        <Setter Property="Background" Value="#0B3D6B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Role}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#0B3D6B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑" Style="{StaticResource IconButtonStyle}" Foreground="#E74C3C"
                                            Command="{Binding DataContext.SupprimerLigneCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Supprimer cet utilisateur"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>
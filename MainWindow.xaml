<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Viewbox Stretch="Fill">
        <Grid Width="800" Height="450">
            <Grid.Background>
                <ImageBrush ImageSource="/WhatsApp Image 2026-06-21 at 12.42.04.jpeg"/>
            </Grid.Background>

            <Button Content="Bienvenue" HorizontalAlignment="Center" Margin="0,327,0,0" VerticalAlignment="Top" FontSize="20" FontWeight="Bold" Command="{Binding NaviguerVersLoginCommand}" Foreground="#FF0B0B12" Height="38">
                <Button.Background>
                    <ImageBrush/>
                </Button.Background>
            </Button>
            <Label Content="Organiser, Suivre et Optimiser votre inventaire en toute simplicité !" HorizontalAlignment="Center" Margin="0,380,0,0" VerticalAlignment="Top" FontWeight="Bold"/>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,410,0,0">
                <TextBlock x:Name="TxtDate" 
                           Text="{Binding DateText}"
                           HorizontalAlignment="Center" 
                           FontSize="13" 
                           FontWeight="Bold" 
                           Foreground="Black"/>
                <TextBlock x:Name="TxtHeure" 
                           Text="{Binding HeureText}"
                           HorizontalAlignment="Center" 
                           FontSize="13" 
                           FontWeight="Bold" 
                           Foreground="Black"/>
            </StackPanel>
        </Grid>
    </Viewbox>

</Window>
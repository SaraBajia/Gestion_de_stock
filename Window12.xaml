<Window x:Class="WpfApp1.Window12"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WpfApp1"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="WindowNouveauMotDePasse" Height="450" Width="800"
        Background="White">

    <Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0">
            <Button x:Name="BtnRetour"
            Content="&#xE76B;"
            FontFamily="Segoe MDL2 Assets"
            FontSize="16"
            Foreground="#0B3D6B"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand"
            Padding="0"
            Width="30" Height="18"
            Command="{Binding RetourCommand}"
            ToolTip="Retour"/>
            <TextBlock Text="AIRBUS" FontSize="24" FontWeight="Bold" Foreground="#0B3D6B" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">

            <TextBlock Text="Réinitialiser le mot de passe" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Choisissez un nouveau mot de passe" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <PasswordBox x:Name="pwdNouveau" materialDesign:HintAssist.Hint="Nouveau mot de passe" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" materialDesign:TextFieldAssist.TrailingIcon="Lock" Margin="0,0,0,24"/>

            <PasswordBox x:Name="pwdConfirmer" materialDesign:HintAssist.Hint="Confirmer le mot de passe" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" materialDesign:TextFieldAssist.TrailingIcon="Lock" Margin="0,0,0,32"/>

            <Button Content="Changer"
                Style="{StaticResource MaterialDesignRaisedButton}"
                Background="#0B3D6B"
                BorderBrush="#0B3D6B"
                Foreground="White"
                Height="45"
                FontWeight="Bold"
                Margin="0,0,0,15"
                Command="{Binding ChangerCommand}"/>

            <TextBlock x:Name="txtMessage" Text="{Binding Message}" Foreground="{Binding MessageColor}" HorizontalAlignment="Center" TextWrapping="Wrap"/>

        </StackPanel>

    </Grid>

</Window>
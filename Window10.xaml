<Window x:Class="WpfApp1.Window10"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Window10" Height="720" Width="1350" WindowStartupLocation="CenterScreen" Background="#F4F6F9" TextElement.Foreground="#3C4A5C" FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="AirbusNavy" Color="#0B3D6B"/>
        <SolidColorBrush x:Key="AirbusNavyDark" Color="#082C4F"/>
        <SolidColorBrush x:Key="TextDark" Color="#3C4A5C"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8A94A6"/>
        <SolidColorBrush x:Key="Bg" Color="#F4F6F9"/>

        <SolidColorBrush x:Key="Green" Color="#1FAE6E"/>
        <SolidColorBrush x:Key="Orange" Color="#F5A524"/>
        <SolidColorBrush x:Key="Red" Color="#E23D3D"/>
        <SolidColorBrush x:Key="Purple" Color="#7C5CFC"/>
        <SolidColorBrush x:Key="Blue" Color="#2E7BF6"/>

        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B3D6B" Offset="0"/>
            <GradientStop Color="#173F72" Offset="0.5"/>
            <GradientStop Color="#2B65A0" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0B3D6B" Opacity="0.06" BlurRadius="18" ShadowDepth="4" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#E4E9F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0B3D6B" Opacity="0.18" BlurRadius="22" ShadowDepth="6" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="GroupName" Value="SidebarNav"/>
            <Setter Property="Foreground" Value="#B9C6DA"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="10" Margin="10,3" Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                                <materialDesign:PackIcon x:Name="Icon" Kind="{TemplateBinding Tag}" Width="19" Height="19" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A5C93"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="#8FD0FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E4E80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogoutBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#E8828B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D96770"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E4E9F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarGradient}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="22,26,20,26">
                    <TextBlock Text="AIRBUS" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Gestion de Stock IT" Foreground="#9DB8D6" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavAccueil" Content="Accueil" Tag="HomeOutline" Style="{StaticResource NavButton}" IsChecked="True"/>
                    <RadioButton x:Name="NavStock" Content="Stock" Tag="FileDocumentOutline" Style="{StaticResource NavButton}"/>
                    <RadioButton x:Name="NavMateriel" Content="Matériel" Tag="DesktopClassic" Style="{StaticResource NavButton}"/>
                    <RadioButton x:Name="NavConsommable" Content="Consommable" Tag="PrinterOutline" Style="{StaticResource NavButton}"/>
                    <RadioButton x:Name="NavPiece" Content="Pièce de rechange" Tag="WrenchOutline" Style="{StaticResource NavButton}"/>
                    <RadioButton x:Name="NavCommande" Content="Commande" Tag="ClipboardTextOutline" Style="{StaticResource NavButton}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="20,0,20,22">
                    <Border Height="1" Background="#2A5578" Margin="0,0,0,14"/>
                    <TextBlock x:Name="TxtUserName" Text="{Binding TxtUserName}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtUserRole" Text="{Binding TxtUserRole}" Foreground="#9DB8D6" FontSize="11.5" Margin="0,2,0,14" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="BtnDeconnecter" Content="Se déconnecter" Style="{StaticResource LogoutBtn}" Command="{Binding DeconnecterCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,18,24,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tableau de bord" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="Vue d'ensemble de la gestion du stock IT" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnFiltrer" Height="42" Background="White" BorderBrush="#E4E9F0" BorderThickness="1" Cursor="Hand" Command="{Binding ToggleFiltreCommand}" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                            <materialDesign:PackIcon Kind="CalendarRange" Width="16" Height="16" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock x:Name="TxtDateRange" Text="{Binding PeriodeActuelle}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                            <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Button>

                    <Popup x:Name="PopupDateFiltre" IsOpen="{Binding PopupDateFiltreOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=BtnFiltrer}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Style="{StaticResource PopupCardStyle}" Width="300" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="Sélectionnez un mois et une année" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock Text="Choisir une période" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                                <TextBlock Text="Année" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CbAnnee" Height="35" Margin="0,0,0,15" ItemsSource="{Binding AnneeOptions}" SelectedItem="{Binding SelectedAnnee, Mode=TwoWay}"/>
                                <TextBlock Text="Mois" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CbMois" Height="35" Margin="0,0,0,15" SelectedIndex="{Binding SelectedMoisIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Janvier" Tag="1"/>
                                    <ComboBoxItem Content="Février" Tag="2"/>
                                    <ComboBoxItem Content="Mars" Tag="3"/>
                                    <ComboBoxItem Content="Avril" Tag="4"/>
                                    <ComboBoxItem Content="Mai" Tag="5"/>
                                    <ComboBoxItem Content="Juin" Tag="6"/>
                                    <ComboBoxItem Content="Juillet" Tag="7"/>
                                    <ComboBoxItem Content="Août" Tag="8"/>
                                    <ComboBoxItem Content="Septembre" Tag="9"/>
                                    <ComboBoxItem Content="Octobre" Tag="10"/>
                                    <ComboBoxItem Content="Novembre" Tag="11"/>
                                    <ComboBoxItem Content="Décembre" Tag="12"/>
                                </ComboBox>

                                <Button Content="Appliquer" Height="38" Background="{StaticResource AirbusNavy}" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Command="{Binding AppliquerDateCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="9">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" TextElement.FontWeight="SemiBold"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button x:Name="BtnExport" Height="42" Padding="16,0" Background="{StaticResource AirbusNavy}" Cursor="Hand" Click="BtnExport_Click" Margin="0,0,14,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter Margin="16,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ExportContextMenu" Background="White">
                                <MenuItem Header="Exporter en Excel (Toutes les données)" Click="ExportExcel_Click">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="FileExcel" Foreground="#1FAE6E" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Exporter en PDF (Graphiques uniquement)" Click="ExportPdf_Click">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="FilePdfBox" Foreground="#E23D3D" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="DownloadOutline" Width="16" Height="16" Foreground="White"/>
                            <TextBlock Text="Exporter" Foreground="White" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"/>
                            <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnGestionCommandes" Style="{StaticResource IconBtn}" Command="{Binding GestionCommandesCommand}" Margin="0,0,10,0" ToolTip="Gestion des commandes">
                        <materialDesign:PackIcon Kind="ClipboardTextClockOutline" Width="19" Height="19" Foreground="{StaticResource TextDark}"/>
                    </Button>

                    <Button x:Name="BtnNotif" Style="{StaticResource IconBtn}" Command="{Binding ToggleNotifCommand}" Margin="0,0,10,0">
                        <Grid>
                            <materialDesign:PackIcon Kind="BellOutline" Width="19" Height="19" Foreground="{StaticResource TextDark}"/>
                            <Border x:Name="NotifBadge" Background="{StaticResource Red}" CornerRadius="8" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0" Visibility="{Binding NotifBadgeVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock x:Name="TxtNotifCount" Text="{Binding NotifCount}" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Popup x:Name="PopupNotifications" IsOpen="{Binding PopupNotificationsOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=BtnNotif}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-260">
                        <Border Style="{StaticResource PopupCardStyle}" Width="320" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="Notifications" FontSize="14" FontWeight="SemiBold" Foreground="#1A2233" Margin="0,0,0,10"/>
                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="NotificationsList" ItemsSource="{Binding Notifications}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#EEF1F5" BorderThickness="0,0,0,1" Padding="0,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="34" Height="34" CornerRadius="9" Background="{Binding IconBg}">
                                                            <materialDesign:PackIcon Kind="{Binding IconKind}" Width="16" Height="16" Foreground="{Binding IconColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Titre}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1A2233" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button x:Name="BtnTheme" Style="{StaticResource IconBtn}" Click="BtnTheme_Click">
                        <materialDesign:PackIcon Kind="WeatherSunny" Width="19" Height="19" Foreground="{StaticResource TextDark}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,6,24,14">
                <StackPanel x:Name="MainChartsContainer">

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="46" Height="46" CornerRadius="12" Background="#E7F0FE">
                                        <materialDesign:PackIcon Kind="DesktopClassic" Width="22" Height="22" Foreground="{StaticResource Blue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Matériels" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtKpiMateriel" Text="{Binding KpiMateriel}" FontSize="26" FontWeight="Bold" Foreground="#1A2233" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="46" Height="46" CornerRadius="12" Background="#E5F7EF">
                                        <materialDesign:PackIcon Kind="PackageVariant" Width="22" Height="22" Foreground="{StaticResource Green}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Consommables" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtKpiConsommable" Text="{Binding KpiConsommable}" FontSize="26" FontWeight="Bold" Foreground="#1A2233" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="46" Height="46" CornerRadius="12" Background="#FFF3E0">
                                        <materialDesign:PackIcon Kind="ToolboxOutline" Width="22" Height="22" Foreground="{StaticResource Orange}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Pièces de rechange" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtKpiPiece" Text="{Binding KpiPiece}" FontSize="26" FontWeight="Bold" Foreground="#1A2233" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="46" Height="46" CornerRadius="12" Background="#F0EBFF">
                                        <materialDesign:PackIcon Kind="ClipboardListOutline" Width="22" Height="22" Foreground="{StaticResource Purple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Commandes en attente" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtKpiCommandes" Text="{Binding KpiCommandes}" FontSize="26" FontWeight="Bold" Foreground="#1A2233" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Répartition du stock par catégorie" FontSize="15" FontWeight="SemiBold" Foreground="#1A2233"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Canvas x:Name="DonutCanvas" Width="150" Height="150" Grid.Column="0"/>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,6">
                                            <Ellipse Width="10" Height="10" Fill="{StaticResource Blue}"/>
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock Text="Matériels" FontSize="13" Foreground="#1A2233"/>
                                                <TextBlock x:Name="TxtLegendMateriel" Text="{Binding LegendMateriel}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,6">
                                            <Ellipse Width="10" Height="10" Fill="{StaticResource Green}"/>
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock Text="Consommables" FontSize="13" Foreground="#1A2233"/>
                                                <TextBlock x:Name="TxtLegendConsommable" Text="{Binding LegendConsommable}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,6">
                                            <Ellipse Width="10" Height="10" Fill="{StaticResource Orange}"/>
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock Text="Pièces de rechange" FontSize="13" Foreground="#1A2233"/>
                                                <TextBlock x:Name="TxtLegendPiece" Text="{Binding LegendPiece}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Évolution du stock (6 derniers mois)" FontSize="15" FontWeight="SemiBold" Foreground="#1A2233"/>
                                <Canvas x:Name="EvolutionCanvas" Height="160" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="Activités Récentes" FontSize="15" FontWeight="SemiBold" Foreground="#1A2233" VerticalAlignment="Center"/>
                                        <TextBlock Text="(Aujourd'hui)" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Button x:Name="BtnVoirToutActivites" Content="Voir toutes les activités" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Blue}" FontWeight="SemiBold" FontSize="12.5" Cursor="Hand" Command="{Binding VoirToutActivitesCommand}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock Text="{TemplateBinding Content}" TextDecorations="None" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Underline"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <ItemsControl x:Name="ActivitesList" ItemsSource="{Binding Activites}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F0F2F5" BorderThickness="0,0,0,1" Padding="0,10,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{Binding IconBg}">
                                                        <materialDesign:PackIcon Kind="{Binding IconKind}" Width="18" Height="18" Foreground="{Binding IconColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Titre}" FontSize="13" FontWeight="SemiBold" Foreground="#1A2233"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding Temps}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Medium"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Mouvements de stock" FontSize="15" FontWeight="SemiBold" Foreground="#1A2233" HorizontalAlignment="Left"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource Green}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Entrées" FontSize="11" Margin="4,0,16,0" Foreground="{StaticResource TextMuted}"/>
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource Red}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sorties" FontSize="11" Margin="4,0,0,0" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                </Grid>
                                <Canvas x:Name="EtatCanvas" Height="140" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Popup x:Name="PopupToutesActivites" IsOpen="{Binding PopupToutesActivitesOpen, Mode=TwoWay}" Placement="Center" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border CornerRadius="16" Background="White" Width="480" Height="500" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#0B3D6B" Opacity="0.25" BlurRadius="25" ShadowDepth="0"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Activités d'Aujourd'hui" FontSize="16" FontWeight="Bold" Foreground="#1A2233"/>
                            <TextBlock Text="Historique complet des mouvements du jour" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding FermerPopupActivitesCommand}">
                            <materialDesign:PackIcon Kind="Close" Width="22" Height="22" Foreground="{StaticResource TextMuted}"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                        <ItemsControl x:Name="ToutesActivitesList" ItemsSource="{Binding ToutesActivites}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F0F2F5" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{Binding IconBg}">
                                                <materialDesign:PackIcon Kind="{Binding IconKind}" Width="18" Height="18" Foreground="{Binding IconColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Titre}" FontSize="13" FontWeight="SemiBold" Foreground="#1A2233"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding Temps}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Medium"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
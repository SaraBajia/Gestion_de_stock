<Window x:Class="WpfApp1.Window11"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WpfApp1"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="WindowQuestionSecurite" Height="450" Width="800"
        Background="White">

    <Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,15,0,0">


            <Button x:Name="BtnRetour"
                    Content="&#xE76B;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    Foreground="#0B3D6B"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="0"
                    Width="30" 
                    Height="30"
                    Command="{Binding RetourCommand}"
                    ToolTip="Retour"/>


            <TextBlock Text="AIRBUS" FontSize="24" FontWeight="Bold" Foreground="#0B3D6B" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">

            <TextBlock Text="Vérification d'identité" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Répondez à la question suivante pour continuer" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,30"/>

            <TextBlock x:Name="txtQuestion" Text="{Binding Question}" FontSize="16" FontWeight="Medium" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24"/>

            <TextBox x:Name="txtReponse" Text="{Binding Reponse, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Votre réponse" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,24"/>

            <Button Content="Vérifier"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#0B3D6B"
                    BorderBrush="#0B3D6B"
                    Foreground="White"
                    Height="45"
                    FontWeight="Bold"
                    Margin="0,0,0,15"
                    Command="{Binding VerifierCommand}"/>

            <TextBlock x:Name="txtErreur" Text="{Binding Erreur}" Foreground="Red" HorizontalAlignment="Center" TextWrapping="Wrap"/>

        </StackPanel>

    </Grid>
</Window>
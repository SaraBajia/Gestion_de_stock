<Window x:Class="WpfApp1.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WpfApp1"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Window2" Height="800" Width="800"
        Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0">
                <Button x:Name="BtnRetour"
            Content="&#xE76B;"
            FontFamily="Segoe MDL2 Assets"
            FontSize="13"
            Foreground="#0B3D6B"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand"
            Padding="0"
            Width="30" Height="18"
            Command="{Binding RetourCommand}"
            ToolTip="Retour"/>
                <TextBlock Text="AIRBUS" FontSize="24" FontWeight="Bold" Foreground="#0B3D6B" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Width="400" Margin="0,62,0,30">

                <TextBlock Text="Créer un compte" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Remplissez vos informations" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,32"/>

                <TextBox x:Name="NomTextBox" Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Nom" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:TextFieldAssist.TrailingIcon="Account" Margin="0,0,0,20"/>
                <TextBox x:Name="PrenomTextBox" Text="{Binding Prenom, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Prénom" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:TextFieldAssist.TrailingIcon="Account" Margin="0,0,0,20"/>

                <ComboBox x:Name="RoleComboBox" SelectedValuePath="Content" SelectedValue="{Binding Role}" materialDesign:HintAssist.Hint="Role" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,20">
                    <ComboBoxItem Content="Admin"/>
                    <ComboBoxItem Content="Technicien"/>
                </ComboBox>

                <TextBox x:Name="EmailTextBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="E-mail" Style="{StaticResource MaterialDesignFloatingHintTextBox}" materialDesign:TextFieldAssist.TrailingIcon="Email" Margin="0,0,0,20"/>

                <PasswordBox x:Name="PasswordBox" materialDesign:HintAssist.Hint="Mot de passe" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" materialDesign:TextFieldAssist.TrailingIcon="Lock" Margin="0,0,0,8" PasswordChanged="PasswordBox_PasswordChanged"/>

                <TextBlock x:Name="txtPasswordInfo" FontSize="11" Foreground="{Binding PasswordInfoColor}" TextWrapping="Wrap" Margin="0,0,0,32"
                           Text="{Binding PasswordInfoText}"/>

                <TextBlock Text="Questions de sécurité" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Ces questions serviront à réinitialiser votre mot de passe" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20"/>

                <TextBlock x:Name="txtQuestion1" Text="{Binding Question1Text}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBox x:Name="Reponse1TextBox" Text="{Binding Reponse1, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Votre réponse" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,20"/>

                <TextBlock x:Name="txtQuestion2" Text="{Binding Question2Text}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBox x:Name="Reponse2TextBox" Text="{Binding Reponse2, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Votre réponse" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,20"/>

                <TextBlock x:Name="txtQuestion3" Text="{Binding Question3Text}" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBox x:Name="Reponse3TextBox" Text="{Binding Reponse3, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Votre réponse" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,32"/>

                <Button x:Name="InscrireButton" Content="Inscrire" Style="{StaticResource MaterialDesignRaisedButton}" Background="#0B3D6B" BorderBrush="#0B3D6B" Foreground="White" Height="45" FontWeight="Bold" Command="{Binding InscrireCommand}" Margin="0,0,0,24"/>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>